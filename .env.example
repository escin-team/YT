# ============================================
# UNIVERSAL ENVIRONMENT VARIABLES
# Compatible: Back4App, Defang, HF Spaces, Railway, Render
# ============================================

# Server Configuration (Auto-detect PORT dari platform)
PORT=8080
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO

# YouTube Crawler Configuration (PENTING - untuk scraping)
YOUTUBE_BASE_URL=https://www.youtube.com/results
YOUTUBE_TIMEOUT=10

# Cloudinary Configuration (WAJIB - 3 akun untuk failover)
CLOUDINARY_ACCOUNTS_JSON=[{"name":"account1","cloud_name":"YOUR_CLOUD_NAME_1","api_key":"YOUR_API_KEY_1","api_secret":"YOUR_API_SECRET_1"},{"name":"account2","cloud_name":"YOUR_CLOUD_NAME_2","api_key":"YOUR_API_KEY_2","api_secret":"YOUR_API_SECRET_2"},{"name":"account3","cloud_name":"YOUR_CLOUD_NAME_3","api_key":"YOUR_API_KEY_3","api_secret":"YOUR_API_SECRET_3"}]

# Redis Configuration (OPTIONAL - default: disabled)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=3
REDIS_PASSWORD=
REDIS_TTL_SECONDS=3600

# Audio Download Configuration
DOWNLOAD_DIR=/tmp/youtube_audio
DOWNLOAD_BASE_URL=http://localhost:8080/downloads
DOWNLOAD_TIMEOUT=300
MAX_VIDEO_DURATION=600
AUDIO_BITRATE=128
CACHE_TTL_HOURS=24

# Logging Configuration
LOG_DIR=logs
LOG_FILE_ENABLED=true
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# MCP (Model Context Protocol) Configuration
MCP_SEARCH_TIMEOUT=15
MCP_SEARCH_RETRIES=3

# Feature Flags
ENABLE_CACHE=true
ENABLE_LOGGING=true

# Rate Limiting Configuration
RATE_LIMIT_DOWNLOAD_PER_HOUR=20
RATE_LIMIT_STATIC_PER_MINUTE=60
RATE_LIMIT_ENABLED=true
